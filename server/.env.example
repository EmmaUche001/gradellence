# =============================================================================
# Gradellence SRMS — Server Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values before running the server.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the NestJS server listens on
PORT=3000

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Full PostgreSQL connection URL (Prisma format)
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5432/srms?schema=public

# PostgreSQL superuser password — also referenced by docker-compose.yml
POSTGRES_PASSWORD=change-me-in-production

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------

# Hostname of the Redis server
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password — leave empty if Redis has no AUTH requirement
REDIS_PASSWORD=

# Redis logical database index (0–15)
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT
# -----------------------------------------------------------------------------

# Secret key used to sign access tokens — must be long and random in production
JWT_ACCESS_SECRET=change-me-in-production

# Secret key used to sign refresh tokens — must differ from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=change-me-in-production-refresh

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRATION=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRATION=7d

# -----------------------------------------------------------------------------
# SMTP (Email)
# -----------------------------------------------------------------------------

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP server port (587 = STARTTLS, 465 = SSL)
SMTP_PORT=587

# SMTP authentication username (usually your email address)
SMTP_USER=your-email@example.com

# SMTP authentication password or app password
SMTP_PASS=change-me-in-production

# From address shown on outgoing emails
SMTP_FROM=Gradellence <noreply@example.com>

# -----------------------------------------------------------------------------
# Monitoring
# -----------------------------------------------------------------------------

# Sentry DSN for error tracking — leave empty to disable Sentry
SENTRY_DSN=

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------

# Public URL of the frontend application (used for CORS and email links)
FRONTEND_URL=http://localhost

# -----------------------------------------------------------------------------
# Seed — Super Admin Account
# -----------------------------------------------------------------------------

# Email address for the super admin user created by the seed script
# Defaults to admin@gradellence.com if not set
SUPER_ADMIN_EMAIL=admin@gradellence.com

# Password for the super admin user created by the seed script
# CHANGE THIS IMMEDIATELY after first deployment
SUPER_ADMIN_PASSWORD=change-me-in-production
